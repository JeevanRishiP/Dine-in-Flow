{
  "name": "@dineflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'api lint passed'",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest watch",
    "test:int": "vitest run --config vitest.int.config.ts --reporter=verbose",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "seed:pilot": "tsx src/tools/seed-pilot-restaurant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@dineflow/contracts": "workspace:*",
    "@fastify/static": "^10.1.7",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.2.8",
    "@phonepe-pg/pg-sdk-node": "^2.0.6",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.2",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "nestjs-zod": "^4.3.1",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@dineflow/config": "workspace:*",
