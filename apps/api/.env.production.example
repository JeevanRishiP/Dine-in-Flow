# ═══════════════════════════════════════════════════════════════════════════════
# DineFlow Backend API — Production Environment Configuration Template
# Reference: ARCH §5, ARCH §6, ARCH §11, AGENTS §2
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=10000

# ── Database Connections (Supabase PostgreSQL) ──────────────────────────────────
# 1. DATABASE_URL: Connects via Supabase Transaction Pooler (PgBouncer port 6543).
#    Transaction-local tenant contexts (`is_local=true`) prevent cross-tenant leaks.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. DIRECT_DATABASE_URL: Connects to Direct PostgreSQL (port 5432).
#    Used strictly by `pnpm db:migrate` for DDL locks and schema migrations.
DIRECT_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_MIGRATOR_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# ── Redis Connection (Upstash / Redis Cloud / AWS ElastiCache) ─────────────────
# Required for distributed rate limiting, pub/sub realtime events, and WebSocket clustering.
REDIS_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:[REDIS_PORT]

# ── Security Keys & Hashes (≥32 characters each) ───────────────────────────────
# Generate with `openssl rand -hex 32`
JWT_SECRET=replace_with_at_least_32_characters_random_hex_string
OTP_HMAC_PEPPER=replace_with_at_least_32_characters_random_hex_string
QR_TOKEN_SECRET=replace_with_at_least_32_characters_random_hex_string

# ── CORS & Front-End Origins ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend production origins
ALLOWED_ORIGINS=https://app.dineflow.in,https://console.dineflow.in
ALLOWED_CORS_ORIGINS=https://app.dineflow.in,https://console.dineflow.in
APP_BASE_URL=https://app.dineflow.in
TRUST_PROXY=true

# ── Optional Default Public Outlet ID ──────────────────────────────────────────
# Set to an active outlet UUID if your deployment defaults to a flagship restaurant
# DEFAULT_PUBLIC_OUTLET_ID=00000000-0000-0000-0000-000000000000

# ── PhonePe Payment Gateway (UPI / QR) ────────────────────────────────────────
PHONEPE_ENV=PRODUCTION
PHONEPE_CLIENT_ID=PROD_MERCHANT_ID
PHONEPE_CLIENT_SECRET=PROD_MERCHANT_KEY
PHONEPE_CLIENT_VERSION=1
PHONEPE_SALT_INDEX=1
PHONEPE_WEBHOOK_USERNAME=dineflow_phonepe_webhook
PHONEPE_WEBHOOK_PASSWORD=replace_with_strong_webhook_auth_password
WEBHOOK_PUBLIC_URL=https://api.dineflow.in

# ── Razorpay Payment Gateway (Cards / NetBanking / International) ─────────────
RAZORPAY_KEY_ID=rzp_live_PLACEHOLDER
RAZORPAY_KEY_SECRET=replace_with_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# ── S3-Compatible Object Storage (Cloudflare R2 / AWS S3) ──────────────────────
# For dish photos, invoices, and QR asset bundles
S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=replace_with_r2_or_s3_access_key
S3_SECRET_KEY=replace_with_r2_or_s3_secret_key
S3_RAW_BUCKET=dineflow-prod-raw
S3_PROCESSED_BUCKET=dineflow-prod-processed

# ── AI Dining Assistant (Google Gemini) ────────────────────────────────────────
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Customer WhatsApp OTP (Official Meta Cloud API) ────────────────────────────
# AGENTS §2 rule 11: Official WhatsApp Cloud API strictly required in production
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=replace_with_system_user_permanent_token

# ── Google OAuth (Sign in with Google) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com
