# ═══════════════════════════════════════════════════════════════════════════════
# DineFlow Console Web — Production Environment Configuration Template (Vercel)
# Staff Management, KDS, Floor View, Captain Console, Analytics
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── API Backend Origin ────────────────────────────────────────────────────────
# Public HTTPS URL of the DineFlow NestJS API deployed on Render
# Note: Next.js will route WebSocket connections (KDS & Floor events)
# to wss://[API_DOMAIN] automatically based on NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=https://api.dineflow.in

# Optional internal rewrite target if running within the same private VPC
# API_INTERNAL_URL=https://api.dineflow.in
