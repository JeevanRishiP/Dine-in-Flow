# ═══════════════════════════════════════════════════════════════════════════════
# DineFlow Customer Web — Production Environment Configuration Template (Vercel)
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ── API Backend Origin ────────────────────────────────────────────────────────
# Public HTTPS URL of the DineFlow NestJS API deployed on Render
NEXT_PUBLIC_API_URL=https://api.dineflow.in

# Optional internal rewrite target if running within the same private VPC
# API_INTERNAL_URL=https://api.dineflow.in

# ── Google OAuth Sign-In ──────────────────────────────────────────────────────
# Google Web Client ID for one-tap & Google Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id.apps.googleusercontent.com

# ── Default Restaurant Routing (Optional) ────────────────────────────────────
# Set these if this domain serves a single flagship restaurant or brand default
# NEXT_PUBLIC_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_DEFAULT_OUTLET_ID=00000000-0000-0000-0000-000000000000
