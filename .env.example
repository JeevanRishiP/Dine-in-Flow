# Local Development Environment Variables
# Copy this to .env.local and fill in values. Never commit .env.local.

NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.dev.yml: 5433 host port avoids conflicts with other projects on 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dineflow_dev
DATABASE_MIGRATOR_URL=postgresql://postgres:postgres@localhost:5433/dineflow_dev

# Redis (matches docker-compose.dev.yml: 6380 host port avoids conflicts with other projects on 6379)
REDIS_URL=redis://localhost:6380

# Secrets — replace with real random values locally (min 32 chars)
JWT_SECRET=dev_jwt_secret_replace_me_with_at_least_32_chars
OTP_HMAC_PEPPER=dev_otp_pepper_replace_me_with_at_least_32_chars
QR_TOKEN_SECRET=dev_qr_secret_replace_me_with_at_least_32_chars

# MinIO (S3-compatible local storage)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_MEDIA=dineflow-media-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# OpenAPI UI (enabled in dev)
OPENAPI_ENABLED=true

# App base URL (used to build returnUrl and webhook endpoints)
APP_BASE_URL=http://localhost:3000

# ── PhonePe Payment Gateway (UPI) ─────────────────────────────────────────────
# Get sandbox credentials from: https://developer.phonepe.com/
# Dashboard → Developer Settings → Sandbox Credentials
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=PGTESTPAYUAT86         # PhonePe official test merchant ID
PHONEPE_CLIENT_SECRET=96434309-7796-489d-8924-ab56988a6076  # test secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=phonepe_webhook_user  # set in PhonePe dashboard → Webhooks
PHONEPE_WEBHOOK_PASSWORD=phonepe_webhook_pass  # set in PhonePe dashboard → Webhooks

# ── Razorpay (Cards / NetBanking / Wallet) ────────────────────────────────────
# Get test keys from: https://dashboard.razorpay.com → Settings → API Keys → Test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx      # replace with your rzp_test_ key
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx      # replace with your test key secret
RAZORPAY_WEBHOOK_SECRET=razorpay_test_webhook_secret_min32chars  # set in Razorpay → Webhooks

# ── Google Business Profile (Feedback & Reviews) ──────────────────────────────
GBP_TOKEN_ENCRYPTION_KEY=dineflow_gbp_aes256_secret_key_32bytes!

# ── Google Sign-In & Default Tenant (Customer Web) ─────────────────────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional default tenant IDs for customer-web / API when opened without ?outlet= / ?slug=:
DEFAULT_PUBLIC_OUTLET_ID=
NEXT_PUBLIC_DEFAULT_ORG_ID=
NEXT_PUBLIC_DEFAULT_OUTLET_ID=

# ── WhatsApp Messaging (Meta Cloud API in prod; isolated Evolution OTP in dev) ─
# Provider options: 'meta' | 'mock' | 'evolution_dev' (evolution_dev forbidden in prod)
WHATSAPP_PROVIDER=evolution_dev
# Isolated DineFlow Evolution Docker container (port 8085, separate from other projects)
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=dineflow_dev_evolution_key
EVOLUTION_INSTANCE_NAME=dineflow_otp

# ── Gemini AI Menu Assistant ──────────────────────────────────────────────────
# Google AI Studio Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite


